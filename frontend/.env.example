NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Next.js server only. Apply the mock payment migration before enabling.
MOCK_PAYMENT_AGENT_ENABLED=false

# Worker only: copy these into an ignored .env.payment-agent file.
# Never prefix secrets with NEXT_PUBLIC_. Never use production financial data.
SUPABASE_SERVICE_ROLE_KEY=your-local-test-service-role-key
OPENROUTER_API_KEY=your-openrouter-key
# Set an exact tool-capable model ID; the worker verifies tools support at startup.
OPENROUTER_MODEL=
PAYMENT_HEADLESS=true
